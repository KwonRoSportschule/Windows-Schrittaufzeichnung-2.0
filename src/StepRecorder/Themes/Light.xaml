<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 (Fluent) light palette -->
    <Color x:Key="Color.WindowBg">#F3F3F3</Color>
    <Color x:Key="Color.Accent">#0067C0</Color>

    <SolidColorBrush x:Key="Brush.WindowBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Layer" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A0A0A0"/>

    <SolidColorBrush x:Key="Brush.Control" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Brush.ControlBorderStrong" Color="#8A8A8A"/>

    <SolidColorBrush x:Key="Brush.Subtle" Color="Transparent"/>
    <SolidColorBrush x:Key="Brush.SubtleHover" Color="#0A000000"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#06000000"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#0F000000"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1975C5"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3183CA"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E5F0FA"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#B02719"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Recording" Color="#E81123"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00"/>

    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputHover" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Brush.InputFocus" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.ImageBg" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Note" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="Brush.NoteBorder" Color="#F2B01E"/>
    <SolidColorBrush x:Key="Brush.Popup" Color="#F9F9F9"/>
    <Color x:Key="Color.Shadow">#33000000</Color>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 (Fluent) dark palette -->
    <Color x:Key="Color.WindowBg">#202020</Color>
    <Color x:Key="Color.Accent">#4CC2FF</Color>

    <SolidColorBrush x:Key="Brush.WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="Brush.Layer" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5D5D5D"/>

    <SolidColorBrush x:Key="Brush.Control" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#323232"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#272727"/>
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.ControlBorderStrong" Color="#9A9A9A"/>

    <SolidColorBrush x:Key="Brush.Subtle" Color="Transparent"/>
    <SolidColorBrush x:Key="Brush.SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#15FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#47B1E8"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#42A1D2"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1F3A50"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#E0453A"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#C93B31"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Recording" Color="#FF4D5B"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100"/>

    <SolidColorBrush x:Key="Brush.Input" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.InputHover" Color="#323232"/>
    <SolidColorBrush x:Key="Brush.InputFocus" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.ImageBg" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Note" Color="#3A3220"/>
    <SolidColorBrush x:Key="Brush.NoteBorder" Color="#F2B01E"/>
    <SolidColorBrush x:Key="Brush.Popup" Color="#2C2C2C"/>
    <Color x:Key="Color.Shadow">#66000000</Color>
</ResourceDictionary>

<Window x:Class="StepRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:StepRecorder.Services"
        Style="{StaticResource FluentWindow}"
        Title="{s:Tr App_Title}" Width="1280" Height="820" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnWindowDrop"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{x:Static ApplicationCommands.SaveAs}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{x:Static ApplicationCommands.Undo}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="OnNew"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpen"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSave"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="OnSaveAs"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="OnUndo"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Icon + label content for command bar buttons -->
        <Style x:Key="CmdIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <DataTemplate x:Key="StepTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Accent}"
                        VerticalAlignment="Top" Margin="2,2,10,0">
                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Brush.AccentText}" FontSize="12"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="1" Width="112" Height="66" CornerRadius="4" ClipToBounds="True"
                        Background="{DynamicResource Brush.ImageBg}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                        BorderThickness="1" VerticalAlignment="Top">
                    <Image Source="{Binding ThumbPath, Converter={StaticResource PathToImage}, ConverterParameter=224}"
                           Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="2" Margin="12,0,4,0">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="58" FontSize="13" LineHeight="19"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource Time}}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Brush.NoteBorder}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= Command bar -->
        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="CommandBar" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RecordButton" Style="{StaticResource AccentButton}" Click="OnRecordClick" Padding="14,6" MinWidth="170">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RecordGlyph" Text="&#xE7C8;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock x:Name="RecordText" Text="{s:Tr Btn_Record}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Click="OnPauseClick" Margin="8,0,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseGlyph" Text="&#xE769;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock x:Name="PauseText" Text="{s:Tr Btn_Pause}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CommentButton" Style="{StaticResource SubtleButton}" Click="OnCommentClick" Margin="4,0,0,0"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90A;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_Comment}"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Separator}"/>

                <Button Style="{StaticResource SubtleButton}" Command="{x:Static ApplicationCommands.New}" ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_New}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{x:Static ApplicationCommands.Open}" ToolTip="Ctrl+O">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_Open}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{x:Static ApplicationCommands.Save}" ToolTip="Ctrl+S">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_Save}"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Separator}"/>

                <!-- Not hit-testable while open: otherwise the click that closes the popup would re-open it -->
                <ToggleButton x:Name="ExportToggle" Style="{StaticResource SubtleToggle}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=ExportPopup, Converter={StaticResource Not}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_Export}"/>
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="8,2,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportToggle}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=ExportToggle, Mode=TwoWay}">
                    <Border Style="{StaticResource Flyout}" Width="300">
                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}" Click="OnExportPdf">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA90;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.Danger}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{s:Tr Export_Pdf}"/>
                                        <TextBlock Text="{s:Tr Export_PdfHint}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="OnExportHtml">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.Accent}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{s:Tr Export_Html}"/>
                                        <TextBlock Text="{s:Tr Export_HtmlHint}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="OnExportZip">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xF012;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.NoteBorder}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{s:Tr Export_Zip}"/>
                                        <TextBlock Text="{s:Tr Export_ZipHint}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="ExportVideoButton" Style="{StaticResource MenuButton}" Click="OnExportVideo">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="18"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{s:Tr Export_Video}"/>
                                        <TextBlock Text="{s:Tr Export_VideoHint}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButton}" Click="OnLanguageClick" ToolTip="{s:Tr Set_Language}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF2B7;" Style="{StaticResource CmdIcon}"/>
                        <TextBlock Text="{s:Tr Btn_Language}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnThemeClick" ToolTip="{s:Tr Set_Theme}" Margin="2,0,0,0">
                    <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnSettingsClick" ToolTip="{s:Tr Btn_Settings}" Margin="2,0,0,0">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================= Content -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Steps list -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,14,10,6">
                        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{s:Tr Untitled}" FontSize="16" FontWeight="SemiBold" ToolTip="{s:Tr Lbl_Title}"
                                 Margin="0,0,4,10"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{s:Tr Lbl_Steps}" Style="{StaticResource Subtitle}"/>
                                <Border CornerRadius="9" Background="{DynamicResource Brush.Selected}" Padding="7,0" Margin="8,0,0,0"
                                        MinWidth="22" Height="18" VerticalAlignment="Center">
                                    <TextBlock x:Name="CountText" Text="0" FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Command="{x:Static ApplicationCommands.Undo}"
                                        ToolTip="{s:Tr Btn_Undo}" Visibility="Collapsed">
                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                                <Button x:Name="UpButton" Style="{StaticResource IconButton}" Click="OnMoveUp" ToolTip="{s:Tr Btn_MoveUp}">
                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                                <Button x:Name="DownButton" Style="{StaticResource IconButton}" Click="OnMoveDown" ToolTip="{s:Tr Btn_MoveDown}">
                                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="OnDelete" ToolTip="{s:Tr Btn_Delete}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="StepList" Grid.Row="1" ItemsSource="{Binding Steps}" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource StepItem}" ItemTemplate="{StaticResource StepTemplate}"
                             AllowDrop="True" Padding="0,0,0,8"
                             SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown"
                             PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                             DragOver="OnListDragOver" Drop="OnListDrop"/>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="32" IsHitTestVisible="False">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Brush.AccentSoft}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="{s:Tr Empty_Title}" Style="{StaticResource Subtitle}" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="300"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Focusable="False"/>

            <!-- Detail / editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid x:Name="Detail" DataContext="{Binding SelectedItem, ElementName=StepList}" Margin="18,14,18,18"
                          Visibility="{Binding Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="StepHeader" Style="{StaticResource Title}"/>
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,90,0">
                                    <Run Text="{Binding Timestamp, Converter={StaticResource Time}, Mode=OneWay}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding WindowTitle, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButton}" Click="OnCopyImage" ToolTip="{s:Tr Btn_CopyImage}">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="OnOpenImage" ToolTip="{s:Tr Btn_OpenImage}">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,12" CornerRadius="6" Background="{DynamicResource Brush.ImageBg}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1" ClipToBounds="True">
                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="4"
                                   MouseLeftButtonDown="OnImageMouseDown" Cursor="Hand"/>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{s:Tr Lbl_Description}" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                     AcceptsReturn="False" MaxHeight="64" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="{s:Tr Lbl_Note}" Style="{StaticResource Caption}" Margin="2,12,0,4"/>
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Tag="{s:Tr Ph_Note}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="76" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{s:Tr NoSelection}" Style="{StaticResource Caption}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                               Visibility="{Binding SelectedItem, ElementName=StepList, Converter={StaticResource InvBoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= Status bar -->
        <Grid Grid.Row="2" Margin="18,8,18,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.TextTertiary}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                <TextBlock x:Name="ElapsedText" Style="{StaticResource Caption}" Margin="12,0,0,0" FontFamily="Consolas, Segoe UI"/>
            </StackPanel>
            <TextBlock x:Name="HotkeyText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>

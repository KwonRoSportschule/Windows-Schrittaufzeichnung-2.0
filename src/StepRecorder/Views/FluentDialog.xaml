<Window x:Class="StepRecorder.Views.FluentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource FluentWindow}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="TitleText" Style="{StaticResource Title}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
            <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="80" MaxHeight="220" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,1,0,0" Padding="24,20">
            <UniformGrid x:Name="Buttons" Rows="1" HorizontalAlignment="Stretch">
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Margin="0,0,4,0" IsDefault="True"
                        Click="OnPrimary"/>
                <Button x:Name="SecondaryButton" Margin="4,0" Click="OnSecondary"/>
                <Button x:Name="CancelButton" Margin="4,0,0,0" IsCancel="True" Click="OnCancel"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
